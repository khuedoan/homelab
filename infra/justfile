set positional-arguments
set shell := ["sh", "-eua", "-c"]

deploy target: (tfstate target) (apply target) (secrets target) (sso target) (forgejo target)

lint:
    terragrunt hcl fmt --check
    tofu fmt -check -recursive .

fmt:
    terragrunt hcl fmt
    tofu fmt -recursive .
    just --fmt

@tfstate target:
    direnv exec "$1" python3 src/scripts/tfstate.py "$1"

@apply target *arguments:
    cd "$1"; \
        shift; \
        exec direnv exec . terragrunt run --all --non-interactive "$@" -- apply

@secrets target:
    direnv exec "$1" python3 src/scripts/sync_secrets.py "$1"

@sso target:
    direnv exec "$1" python3 src/scripts/sso.py "$1"

@forgejo target:
    direnv exec "$1" python3 src/scripts/forgejo.py "$1"
