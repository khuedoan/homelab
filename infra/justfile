set positional-arguments
set shell := ["sh", "-eua", "-c"]

@deploy target:
    . "./$1/.env"; \
        python3 src/scripts/tfstate.py "$1"; \
        just apply "$1"; \
        just secrets "$1"; \
        just sso "$1"; \
        just forgejo "$1"

lint:
    terragrunt hcl fmt --check
    tofu fmt -check -recursive .

fmt:
    terragrunt hcl fmt
    tofu fmt -recursive .
    just --fmt

@tfstate target:
    . "./$1/.env"; \
        python3 src/scripts/tfstate.py "$1"

@apply target *arguments:
    . "./$1/.env"; \
        cd "$1"; \
        shift; \
        exec terragrunt run --all --non-interactive "$@" -- apply

@secrets target:
    . "./$1/.env"; \
        python3 src/scripts/sync_secrets.py "$1"

@sso target:
    . "./$1/.env"; \
        python3 src/scripts/sso.py "$1"

@forgejo target:
    . "./$1/.env"; \
        python3 src/scripts/forgejo.py "$1"
