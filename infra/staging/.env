CLOUDFLARE_ACCOUNT_ID="$(pass "homelab/staging/cloudflare/account-id")"
CLOUDFLARE_API_TOKEN_ID="$(pass "homelab/staging/cloudflare/token-id")"
CLOUDFLARE_API_TOKEN="$(pass "homelab/staging/cloudflare/token")"

AWS_ACCESS_KEY_ID="$CLOUDFLARE_API_TOKEN_ID"
AWS_SECRET_ACCESS_KEY="$(printf '%s' "$CLOUDFLARE_API_TOKEN" | sha256sum | cut -d ' ' -f1)"
